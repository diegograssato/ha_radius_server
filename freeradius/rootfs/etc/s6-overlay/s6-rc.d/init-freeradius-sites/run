#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash
# ==============================================================================
# Cria os symlinks de sites-enabled no primeiro boot
# ==============================================================================

# Ativa os virtual servers padrão
ln -sf /etc/freeradius/sites-available/default \
       /etc/raddb/sites-enabled/default 2>/dev/null || true

ln -sf /etc/freeradius/sites-available/inner-tunnel \
       /etc/raddb/sites-enabled/inner-tunnel 2>/dev/null || true

bashio::log.info "Sites do FreeRADIUS ativados." 

ln -sf /etc/freeradius/sites-available/status \
       /etc/raddb/sites-enabled/status 2>/dev/null || true       

bashio::log.info "Status do FreeRADIUS ativado." 